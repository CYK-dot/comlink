{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "board",
            "type": "pickString",
            "description": "选择目标板（对应一个 strata preset）",
            "options": [
                "ch572-evb",
                "ch32x035-evb"
            ],
            "default": "ch572-evb"
        }
    ],
    "tasks": [
        {
            "label": "全量清除",
            "detail": "删除 build/ 目录（所有板子的构建目录一起清除）",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "配置",
            "detail": "cmake --preset <board>（ch572-evb / ch32x035-evb）",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "${input:board}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "构建 bootloader",
            "detail": "构建 <board> 的 bootloader.elf 与 bootloader.hex",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/${input:board}",
                "--target",
                "bootloader_hex",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置",
            "dependsOrder": "sequence",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "构建 app",
            "detail": "构建 <board> 的 app.elf（已签名）与 app.hex",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/${input:board}",
                "--target",
                "app_hex",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置",
            "dependsOrder": "sequence",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "构建全镜像",
            "detail": "构建 <board> 的 bootloader + app，并合并出 full.hex",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/${input:board}",
                "--target",
                "full",
                "app_hex",
                "bootloader_hex",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "构建全部款型",
            "detail": "依次配置并构建所有款型（ch572-evb、ch32x035-evb）的 full.hex / app.hex / bootloader.hex",
            "dependsOrder": "sequence",
            "dependsOn": [
                "构建款型 ch572-evb",
                "构建款型 ch32x035-evb"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "配置款型 ch572-evb",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "ch572-evb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "hide": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "构建款型 ch572-evb",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "ch572-evb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置款型 ch572-evb",
            "dependsOrder": "sequence",
            "hide": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "配置款型 ch32x035-evb",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "ch32x035-evb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "hide": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "构建款型 ch32x035-evb",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "ch32x035-evb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "配置款型 ch32x035-evb",
            "dependsOrder": "sequence",
            "hide": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
